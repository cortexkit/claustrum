{
  "name": "@cortexkit/claustrum-client",
  "version": "0.12.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cortexkit/claustrum.git",
    "directory": "packages/client"
  },
  "publishConfig": {
    "access": "public"
  },
  "description": "Policy-free TypeScript transport client for the Claustrum credential vault.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepack": "rm -rf dist && bun run build",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@cortexkit/store": "^0.2.1",
    "@cortexkit/subc-client": "^0.22.0"
  }
}
